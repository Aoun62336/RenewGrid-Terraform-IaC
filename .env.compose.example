# RenewGrid — Local Docker Compose Configuration
# Copy this file to .env.compose and replace the placeholders.
# Never commit .env.compose with real credentials.

# PostgreSQL
POSTGRES_DB=renewgrid
POSTGRES_USER=renewgrid
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Application security
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
REFRESH_SECRET_KEY=REPLACE_WITH_RANDOM_REFRESH_SECRET

# Local application port (8090 used for Terraform IaC deployment)
APP_PORT=8090
APP_ENV=development
COOKIE_SECURE=false

# Verified RenewGrid application images from Task 2 (optional override)
# API_IMAGE=docker.io/fire2686/renewgrid-jenkins-api@sha256:6006bbabb86e874edadaebe1330a2a5853add5c863a295ee8491bd17c7354cd1
# WEB_IMAGE=docker.io/fire2686/renewgrid-jenkins-web@sha256:dc8166fc3ea94caa3ed0e46b90aac039be611cbc0dda40336e943daeb6879e7d